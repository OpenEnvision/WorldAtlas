# WorldAtlas Arena site server — copy to site/.env and fill in values.
# Restart with ./start-worldarena-site.sh after editing.

# Public URL used for OAuth redirect URIs (no trailing slash).
# Local dev: http://127.0.0.1:4173
# Production: https://your-domain.example
WORLDARENA_SITE_URL=http://127.0.0.1:4173

# Random secret for signing session cookies (required in production).
WORLDARENA_AUTH_SECRET=change-me-to-a-long-random-string

# Set to true only for local dev without OAuth (not recommended for production).
WORLDARENA_ALLOW_GUEST_AUTH=false

# Require sign-in before submitting arena votes (default: true).
WORLDARENA_REQUIRE_AUTH_FOR_VOTES=true

# --- GitHub OAuth (https://github.com/settings/developers) ---
# Authorization callback URL:
#   ${WORLDARENA_SITE_URL}/api/auth/oauth/github/callback
WORLDARENA_GITHUB_CLIENT_ID=
WORLDARENA_GITHUB_CLIENT_SECRET=

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI:
#   ${WORLDARENA_SITE_URL}/api/auth/oauth/google/callback
WORLDARENA_GOOGLE_CLIENT_ID=
WORLDARENA_GOOGLE_CLIENT_SECRET=

# --- Hugging Face OAuth (https://huggingface.co/settings/applications) ---
# Redirect URL:
#   ${WORLDARENA_SITE_URL}/api/auth/oauth/huggingface/callback
WORLDARENA_HF_CLIENT_ID=
WORLDARENA_HF_CLIENT_SECRET=
