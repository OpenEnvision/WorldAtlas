+def _rollout_paths(dest, key):
+    return dest / f".{key}.rollout.safetensors", dest / f".{key}.rollout.json"
+
+
+def _staged_rollout(dest, key, identity, geometry):
+    """Return a verified rollout receipt, or require a fresh rollout."""
+    from safetensors import safe_open
+
+    latent_path, receipt_path = _rollout_paths(dest, key)
+    if not receipt_path.is_file():
+        return None
+    receipt = json.loads(receipt_path.read_text())
+    if receipt.get("schema") != "solarwm.h3-source-rollout.v1":
+        raise ValueError(f"Staged H3 rollout has an unknown receipt: {receipt_path}")
+    if receipt.get("result_identity") != identity:
+        raise ValueError(f"Staged H3 rollout belongs to another input: {receipt_path}")
+    if not latent_path.is_file() or sha(latent_path) != receipt.get("latents_sha256"):
+        raise ValueError(f"Staged H3 rollout differs from its receipt: {latent_path}")
+    with safe_open(str(latent_path), framework="pt", device="cpu") as handle:
+        if handle.keys() != ["generated_latents"] or tuple(
+            handle.get_slice("generated_latents").get_shape()
+        ) != (1, 24, geometry.decode_latents, 48, 84):
+            raise ValueError(f"Staged H3 rollout has invalid shape: {latent_path}")
+    return receipt
+
+
+def _save_rollout(dest, key, identity, geometry, latents, generation_seconds):
+    from safetensors.torch import save_file
+    import torch
+
+    started = time.perf_counter()
+    latent_path, receipt_path = _rollout_paths(dest, key)
+    part = latent_path.with_name(f".{latent_path.name}.{os.getpid()}.tmp")
+    value = latents[:, :, : geometry.decode_latents].float().cpu().contiguous()
+    if tuple(value.shape) != (1, 24, geometry.decode_latents, 48, 84):
+        raise ValueError(f"Unexpected H3 rollout shape for {key}: {tuple(value.shape)}")
+    if not bool(torch.isfinite(value).all()):
+        raise FloatingPointError(f"Non-finite H3 rollout for {key}")
+    try:
+        save_file({"generated_latents": value}, str(part))
+        part.replace(latent_path)
+    finally:
+        part.unlink(missing_ok=True)
+    atomic_json(
+        receipt_path,
+        dict(
+            schema="solarwm.h3-source-rollout.v1",
+            result_identity=identity,
+            latents_sha256=sha(latent_path),
+            generation_seconds=generation_seconds,
+            staging_seconds=time.perf_counter() - started,
+        ),
+    )
+
