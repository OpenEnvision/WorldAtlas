---
import type { Props } from "@astrojs/starlight/props";

const { siteTitle } = Astro.props;
const homeHref = import.meta.env.BASE_URL;
const siteHref = "/";
---

<a href={homeHref} class="site-title sl-flex">
  <img
    class="site-title-logo"
    src="/assets/worldatlas-logo-cropped2.svg"
    alt=""
    width="22"
    height="22"
    loading="eager"
  />
  <span class="site-title-text">{siteTitle}</span>
</a>
<a href={siteHref} class="site-home-link">Arena Home</a>

<style>
  .site-title {
    gap: 0.55rem;
    align-items: center;
    min-width: 0;
    color: var(--sl-color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .site-title:hover {
    text-decoration: none;
  }

  .site-title-logo {
    width: auto;
    height: 22px;
  }

  .site-title-text {
    white-space: nowrap;
  }

  .site-home-link {
    margin-left: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .site-home-link:hover {
    color: var(--sl-color-text);
    text-decoration: none;
  }
</style>
